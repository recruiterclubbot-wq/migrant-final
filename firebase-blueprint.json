{
  "entities": {
    "Vacancy": {
      "title": "Vacancy",
      "description": "International job vacancy published on MIGRANT.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Job title in Russian."
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Country display name (e.g. Германия, Польша)."
        },
        "countryCode": {
          "type": "string",
          "enum": ["DE", "PL", "CZ", "UA", "NL", "LT", "EU"],
          "description": "ISO-like country code for flag rendering."
        },
        "profession": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Profession category for filtering."
        },
        "salaryText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Hourly or base salary string."
        },
        "salaryMonthlyText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Monthly salary display string."
        },
        "schedule": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Work schedule details."
        },
        "housing": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Accommodation details."
        },
        "contractType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Contract and official employment details."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Detailed job description."
        },
        "iconType": {
          "type": "string",
          "enum": ["plumbing", "painting", "warehouse", "manufacturing", "logistics", "support", "construction"],
          "description": "3D icon identifier for the vacancy card."
        },
        "active": {
          "type": "boolean",
          "description": "Whether vacancy is visible to public."
        },
        "createdBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "country",
        "countryCode",
        "profession",
        "salaryText",
        "salaryMonthlyText",
        "schedule",
        "housing",
        "contractType",
        "description",
        "iconType",
        "active",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account and personal cabinet data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "accountType": {
          "type": "string",
          "enum": ["candidate", "employer"]
        },
        "desiredCountry": {
          "type": "string",
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "maxLength": 600
        },
        "role": {
          "type": "string",
          "enum": ["candidate", "employer", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "blocked"]
        },
        "savedVacancyIds": {
          "type": "string",
          "maxLength": 500,
          "description": "Bounded list stored as native array in Firestore (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "fullName", "accountType", "role", "status", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted admin role assignment document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Application": {
      "title": "Application",
      "description": "Authenticated user job application or B2B staffing request.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["job_application", "b2b_request", "consultation"]
        },
        "vacancyId": {
          "type": "string",
          "maxLength": 128
        },
        "vacancyTitle": {
          "type": "string",
          "maxLength": 140
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "country": {
          "type": "string",
          "maxLength": 60
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "staffCount": {
          "type": "string",
          "maxLength": 40
        },
        "comment": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "approved", "rejected"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "fullName", "phone", "status", "createdAt", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Public lead submission from unauthenticated visitors.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["job_application", "b2b_request", "consultation"]
        },
        "vacancyId": {
          "type": "string",
          "maxLength": 128
        },
        "vacancyTitle": {
          "type": "string",
          "maxLength": 140
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "country": {
          "type": "string",
          "maxLength": 60
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "staffCount": {
          "type": "string",
          "maxLength": 40
        },
        "comment": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "approved", "rejected"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "fullName", "phone", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/vacancies/{vacancyId}": {
      "schema": { "$ref": "#/entities/Vacancy" },
      "description": "Public job vacancies managed by admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User cabinet profiles with strict owner/admin PII isolation."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Trusted admin privilege registry."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Authenticated user job applications and B2B requests."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Guest lead submissions readable and manageable only by admins."
    }
  }
}
